{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contratos.entralo.invalid/events/order-scope-snapshot.v1.schema.json",
  "title": "OrderScopeSnapshot",
  "description": "Lifecycle planning. R07 remanente ORDER congelado por ciclo, SHA256 RFC8785 sin snapshot_digest e items ordenados line_id/ordinal/ticket_id. Sumas/pertenencia/caps en aplicación. R04 no usa este snapshot.",
  "type": "object", "additionalProperties": false,
  "required": ["order_id", "refund_id", "cycle_version", "reason", "milestone_version", "currency", "items", "amount", "snapshot_digest"],
  "properties": {
    "order_id": {"type": "string", "format": "uuid"},
    "refund_id": {"type": "string", "format": "uuid"},
    "cycle_version": {"type": "integer", "minimum": 1},
    "reason": {"enum": ["EVENT_CANCELLED", "EVENT_CHANGED"]},
    "milestone_version": {"type": "integer", "minimum": 1},
    "currency": {"const": "COP"},
    "items": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "adjustment-snapshot.v1.schema.json#/$defs/item"}},
    "amount": {"$ref": "adjustment-snapshot.v1.schema.json#/$defs/money"},
    "snapshot_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
