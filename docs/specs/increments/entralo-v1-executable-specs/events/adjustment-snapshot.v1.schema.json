{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contratos.entralo.invalid/events/adjustment-snapshot.v1.schema.json",
  "title": "AdjustmentSnapshot",
  "description": "Lifecycle planning. RefundAdjustment es el agregado lógico identificado por order_id/adjustment_id; AdjustmentSnapshot es su representación inmutable. R07 devuelve sólo nominal; paid_allocation conserva cargo e impuestos originalmente pagados sin autorizar devolverlos. Sumas, pertenencia y límites por componente se validan en aplicación.",
  "type": "object",
  "additionalProperties": false,
  "required": ["adjustment_id", "order_id", "version", "created_at", "currency", "items", "nominal_total", "service_total", "nominal_tax_total", "service_tax_total", "amount", "snapshot_digest"],
  "properties": {
    "adjustment_id": {"type": "string", "format": "uuid"},
    "order_id": {"type": "string", "format": "uuid"},
    "version": {"type": "integer", "const": 1},
    "created_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "currency": {"const": "COP"},
    "items": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/item"}},
    "nominal_total": {"$ref": "#/$defs/money"},
    "service_total": {"const": "0.00"},
    "nominal_tax_total": {"const": "0.00"},
    "service_tax_total": {"const": "0.00"},
    "amount": {"$ref": "#/$defs/money"},
    "snapshot_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "component": {"type": "string", "enum": ["NOMINAL", "SERVICE", "NOMINAL_TAX", "SERVICE_TAX"], "description": "Enum conceptual igual claim.component de persistencia; no DTO HTTP. Allocation JSON snake_case correspondiente. R07 sólo claim NOMINAL positivo, no TOTAL ni TAX agregado."},
    "money": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"},
    "ticket": {
      "type": "object", "additionalProperties": false,
      "required": ["line_id", "ordinal", "ticket_id"],
      "properties": {
        "line_id": {"type": "string", "format": "uuid"},
        "ordinal": {"type": "integer", "minimum": 1},
        "ticket_id": {"type": "string", "format": "uuid"}
      }
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["ticket", "paid_allocation", "nominal", "service", "nominal_tax", "service_tax", "refundable_amount"],
      "properties": {
        "ticket": {"$ref": "#/$defs/ticket"},
        "paid_allocation": {"$ref": "#/$defs/paidAllocation"},
        "nominal": {"$ref": "#/$defs/money"},
        "service": {"const": "0.00"},
        "nominal_tax": {"const": "0.00"},
        "service_tax": {"const": "0.00"},
        "refundable_amount": {"$ref": "#/$defs/money"}
      }
    },
    "paidAllocation": {
      "type": "object", "additionalProperties": false,
      "required": ["nominal", "service", "nominal_tax", "service_tax", "total"],
      "properties": {
        "nominal": {"$ref": "#/$defs/money"},
        "service": {"$ref": "#/$defs/money"},
        "nominal_tax": {"$ref": "#/$defs/money"},
        "service_tax": {"$ref": "#/$defs/money"},
        "total": {"$ref": "#/$defs/money"}
      },
      "description": "Asignación original por boleta desde order_line/PRICE-01; total=sum(componentes). No son componentes a devolver. Inmutable e incluida en snapshot_digest."
    }
  }
}
