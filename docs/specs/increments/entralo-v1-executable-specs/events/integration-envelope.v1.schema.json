        "fiscal": {"$ref": "#/$defs/fiscal"}
      }
    },
    "fiscal": {
      "type": "object", "additionalProperties": false, "required": ["lines", "cultural_applicable", "cultural_authorization_reference", "parafiscal_rate", "validated_by"],
      "properties": {
        "lines": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["line_kind", "classification", "taxable_base", "rate", "liable_role", "qualification_reference"], "properties": {"line_kind": {"enum": ["NOMINAL", "SERVICE"]}, "classification": {"enum": ["TAXABLE", "EXCLUDED_476_11", "NOT_APPLICABLE"]}, "taxable_base": {"enum": ["UNIT_NOMINAL", "UNIT_SERVICE"]}, "rate": {"type": "string", "pattern": "^(0|1|0\\.[0-9]{1,6})$"}, "liable_role": {"type": "string", "minLength": 1, "maxLength": 100}, "qualification_reference": {"type": "string", "minLength": 1, "maxLength": 200}}}},
        "cultural_applicable": {"type": "boolean"}, "cultural_authorization_reference": {"type": ["string", "null"], "maxLength": 200}, "parafiscal_rate": {"enum": ["0.10", null]}, "validated_by": {"$ref": "#/$defs/uuid"}
      }
    },
    "offerResult": {"type": "object", "additionalProperties": false, "required": ["event_id", "offer_version", "outcome", "reason"], "properties": {"event_id": {"$ref": "#/$defs/uuid"}, "offer_version": {"$ref": "#/$defs/version"}, "outcome": {"enum": ["APPLIED", "REJECTED"]}, "reason": {"type": ["string", "null"], "maxLength": 100}}},
    "milestone": {"type": "object", "additionalProperties": false, "required": ["event_id", "event_version", "close_at", "closure_id", "milestone_version", "kind", "recorded_at"], "properties": {"event_id": {"$ref": "#/$defs/uuid"}, "event_version": {"$ref": "#/$defs/version"}, "close_at": {"$ref": "#/$defs/instant"}, "closure_id": {"$ref": "#/$defs/uuid"}, "milestone_version": {"$ref": "#/$defs/version"}, "kind": {"enum": ["CHANGE", "CANCEL"]}, "recorded_at": {"$ref": "#/$defs/instant"}}, "description": "Registro inicial antes ACK; event_version=recorded_event_version. CHANGE recorded_at=latest_change_at=change_recorded_at; CANCEL recorded_at=cancelled_at. Nunca renovar por commit operativo."},
    "paymentFact": {
      "type": "object", "additionalProperties": false,
      "required": ["order_id", "payment_intent_id", "evidence_id", "observation_version", "payment_state", "payment_approved_at", "amount", "currency", "payment_start_fence", "grace_end_at", "reconciliation_deadline", "observed_at", "canonical_confirmed_at", "evidence_digest"],
      "properties": {"order_id": {"$ref": "#/$defs/uuid"}, "payment_intent_id": {"$ref": "#/$defs/uuid"}, "evidence_id": {"$ref": "#/$defs/uuid"}, "observation_version": {"$ref": "#/$defs/version"}, "payment_state": {"enum": ["APPROVED", "DECLINED", "FAILED", "UNKNOWN"]}, "payment_approved_at": {"$ref": "#/$defs/nullableInstant"}, "amount": {"$ref": "#/$defs/money"}, "currency": {"const": "COP"}, "payment_start_fence": {"$ref": "#/$defs/version"}, "grace_end_at": {"$ref": "#/$defs/instant"}, "reconciliation_deadline": {"$ref": "#/$defs/instant"}, "observed_at": {"$ref": "#/$defs/instant"}, "canonical_confirmed_at": {"$ref": "#/$defs/instant"}, "evidence_digest": {"$ref": "#/$defs/digest"}},
      "allOf": [{"if": {"properties": {"payment_state": {"const": "APPROVED"}}}, "then": {"properties": {"payment_approved_at": {"$ref": "#/$defs/instant"}}}}]
    },
    "reconcile": {"type": "object", "additionalProperties": false, "required": ["order_id", "payment_intent_id", "cycle_version"], "properties": {"order_id": {"$ref": "#/$defs/uuid"}, "payment_intent_id": {"$ref": "#/$defs/uuid"}, "cycle_version": {"$ref": "#/$defs/version"}}},
    "issue": {
