      "properties": {"order_id": {"$ref": "#/$defs/uuid"}, "issuance_id": {"$ref": "#/$defs/uuid"}, "user_id": {"$ref": "#/$defs/uuid"}, "event_id": {"$ref": "#/$defs/uuid"}, "sale_authorization_version": {"$ref": "#/$defs/version"}, "payment_start_fence": {"$ref": "#/$defs/version"}, "accepted_at": {"$ref": "#/$defs/instant"}, "payment_approved_at": {"$ref": "#/$defs/instant"}, "grace_end_at": {"$ref": "#/$defs/instant"}, "reconciliation_deadline": {"$ref": "#/$defs/instant"}, "evidence_id": {"$ref": "#/$defs/uuid"}, "attempt_number": {"type": "integer", "minimum": 1, "maximum": 3}, "lines": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "object", "additionalProperties": false, "required": ["line_id", "quantity"], "properties": {"line_id": {"$ref": "#/$defs/uuid"}, "quantity": {"type": "integer", "minimum": 1}}}}}
    },
    "closeIssue": {"type": "object", "additionalProperties": false, "required": ["order_id", "issuance_id", "user_id", "event_id", "sale_authorization_version", "payment_start_fence", "accepted_at", "payment_approved_at", "grace_end_at", "reconciliation_deadline"], "properties": {"order_id": {"$ref": "#/$defs/uuid"}, "issuance_id": {"$ref": "#/$defs/uuid"}, "user_id": {"$ref": "#/$defs/uuid"}, "event_id": {"$ref": "#/$defs/uuid"}, "sale_authorization_version": {"$ref": "#/$defs/version"}, "payment_start_fence": {"$ref": "#/$defs/version"}, "accepted_at": {"$ref": "#/$defs/instant"}, "payment_approved_at": {"$ref": "#/$defs/instant"}, "grace_end_at": {"$ref": "#/$defs/instant"}, "reconciliation_deadline": {"$ref": "#/$defs/instant"}}},
    "refundGuard": {"type": "object", "additionalProperties": false, "required": ["order_id", "refund_id", "cycle_version", "reason", "control_version", "scope", "adjustment_id", "adjustment_snapshot", "scope_snapshot", "snapshot_digest", "tickets"], "properties": {"order_id": {"$ref": "#/$defs/uuid"}, "refund_id": {"$ref": "#/$defs/uuid"}, "cycle_version": {"$ref": "#/$defs/version"}, "reason": {"enum": ["EVENT_CANCELLED", "EVENT_CHANGED"]}, "control_version": {"$ref": "#/$defs/version"}, "scope": {"enum": ["ORDER", "ADJUSTMENT"]}, "adjustment_id": {"type": ["string", "null"], "format": "uuid"}, "adjustment_snapshot": {"oneOf": [{"$ref": "adjustment-snapshot.v1.schema.json"}, {"type": "null"}]}, "scope_snapshot": {"oneOf": [{"$ref": "order-scope-snapshot.v1.schema.json"}, {"type": "null"}]}, "snapshot_digest": {"$ref": "#/$defs/digest"}, "tickets": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "adjustment-snapshot.v1.schema.json#/$defs/ticket"}}}},
    "issueResult": {"type": "object", "additionalProperties": false, "required": ["order_id", "issuance_id", "guard", "version", "ticket_ids", "previous_attempt_outcome"], "properties": {"order_id": {"$ref": "#/$defs/uuid"}, "issuance_id": {"$ref": "#/$defs/uuid"}, "guard": {"enum": ["OPEN", "ISSUED", "CLOSED"]}, "version": {"$ref": "#/$defs/version"}, "ticket_ids": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/uuid"}}, "previous_attempt_outcome": {"enum": ["NONE", "ISSUED", "RETRYABLE_TRANSIENT", "NON_RETRYABLE_DEFINITIVE", "UNCERTAIN"]}}},
    "guardResult": {"type": "object", "additionalProperties": false, "required": ["order_id", "refund_id", "cycle_version", "version", "state", "used", "as_of"], "properties": {"order_id": {"$ref": "#/$defs/uuid"}, "refund_id": {"$ref": "#/$defs/uuid"}, "cycle_version": {"$ref": "#/$defs/version"}, "version": {"$ref": "#/$defs/version"}, "state": {"enum": ["BLOCKED", "REJECTED_USED", "RELEASED"]}, "used": {"type": "boolean"}, "as_of": {"$ref": "#/$defs/instant"}}},
    "releaseGuard": {"type": "object", "additionalProperties": false, "required": ["order_id", "refund_id", "cycle_version", "guard_version", "snapshot_digest", "release_reason", "absence_evidence_id"], "properties": {"order_id": {"$ref": "#/$defs/uuid"}, "refund_id": {"$ref": "#/$defs/uuid"}, "cycle_version": {"$ref": "#/$defs/version"}, "guard_version": {"type": ["integer", "null"], "minimum": 1}, "snapshot_digest": {"$ref": "#/$defs/digest"}, "release_reason": {"enum": ["SUPPORT_REJECTED", "ELIGIBILITY_REJECTED", "FAILED_NO_EFFECT"]}, "absence_evidence_id": {"type": ["string", "null"], "format": "uuid"}}, "allOf": [{"if": {"properties": {"release_reason": {"const": "FAILED_NO_EFFECT"}}}, "then": {"properties": {"absence_evidence_id": {"$ref": "#/$defs/uuid"}}}}]},
