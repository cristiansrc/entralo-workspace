{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contratos.entralo.invalid/events/integration-envelope.v1.schema.json",
  "title": "IntegrationEnvelopeV1",
  "description": "Lifecycle planning. Contrato fuente único versionado; mensajes internos SQS sin token/PII/QR/preimage/URL bearer. order_id nullable sólo eventos sin orden. Retención y keys en integration-contract.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "type", "schema_version", "producer", "aggregate_id", "aggregate_version", "occurred_at", "correlation_id", "idempotency_key", "order_id", "payload"],
  "properties": {
    "event_id": {"$ref": "#/$defs/uuid"},
    "type": {"enum": ["ChangeRequestedV1", "ChangeCommittedV1", "EventCancelledV1", "ChangeAcknowledgedV1", "OfferChangeRequestedV1", "OfferAppliedV1", "OfferRejectedV1", "EventMilestoneRecordedV1", "ChangeReopenRequestedV1", "ChangeReopenPreparedV1", "ChangeReopenCommittedV1", "EventSaleGateOpenedV1", "CanonicalPaymentFactV1", "ReconcilePaymentRequestedV1", "IssueTicketsRequestedV1", "CloseIssuanceRequestedV1", "BlockTicketsForRefundV1", "ReleaseRefundGuardV1", "RefundGuardReleasedV1", "TicketsIssuedV1", "IssuanceClosedV1", "RefundGuardAppliedV1", "ExecuteRefundRequestedV1", "RefundObservedV1", "SetTicketsRefundedV1", "EmissionCommittedV1", "ProofStatusObservedV1", "ContactReferenceChangedV1", "NotificationRequestedV1"]},
    "schema_version": {"const": 1},
    "producer": {"enum": ["identity", "catalog", "purchases", "payments", "ticketing", "blockchain"]},
    "aggregate_id": {"$ref": "#/$defs/uuid"},
    "aggregate_version": {"type": "integer", "minimum": 1},
    "occurred_at": {"$ref": "#/$defs/instant"},
    "correlation_id": {"$ref": "#/$defs/uuid"},
    "causation_id": {"$ref": "#/$defs/uuid"},
    "traceparent": {"type": "string", "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 300},
    "order_id": {"type": ["string", "null"], "format": "uuid"},
    "payload": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "ExecuteRefundRequestedV1"}}, "required": ["type"]}, "then": {"properties": {"payload": {"description": "AC-N1: R04 de cobro canónico sin venta por fence ganador usa SYSTEM_R04 y total original incluyendo servicio/impuestos. R07 de venta válida conserva SUPPORT o excepción PRODUCT_OWNER; jamás SYSTEM_R04. Prueba no venta/no emisión distinta de ausencia monetaria FAILED_FINAL. Validación de hechos/importe en aplicación, sin permiso de ejecución.", "allOf": [{"if": {"properties": {"reason": {"const": "R04"}}, "required": ["reason"]}, "then": {"properties": {"scope": {"const": "ORDER"}, "authority": {"const": "SYSTEM_R04"}, "adjustment_id": {"type": "null"}, "adjustment_snapshot": {"type": "null"}, "scope_snapshot": {"type": "null"}, "absence_evidence_id": {"$ref": "#/$defs/uuid"}}}}, {"if": {"properties": {"reason": {"enum": ["EVENT_CANCELLED", "EVENT_CHANGED"]}}, "required": ["reason"]}, "then": {"properties": {"authority": {"enum": ["SUPPORT", "PRODUCT_OWNER"]}}}}]}}}},
    {"if": {"properties": {"type": {"enum": ["BlockTicketsForRefundV1", "ExecuteRefundRequestedV1", "SetTicketsRefundedV1"]}}}, "then": {"properties": {"payload": {"allOf": [{"if": {"properties": {"scope": {"const": "ADJUSTMENT"}}}, "then": {"properties": {"scope_snapshot": {"type": "null"}}}}, {"if": {"properties": {"scope": {"const": "ORDER"}, "reason": {"enum": ["EVENT_CANCELLED", "EVENT_CHANGED"]}}, "required": ["reason"]}, "then": {"properties": {"scope_snapshot": {"$ref": "order-scope-snapshot.v1.schema.json"}}}}, {"if": {"properties": {"scope": {"const": "ORDER"}}, "not": {"required": ["reason"]}}, "then": {"properties": {"scope_snapshot": {"$ref": "order-scope-snapshot.v1.schema.json"}}}}]}}}},
    {"if": {"properties": {"type": {"const": "ChangeRequestedV1"}}}, "then": {"properties": {"producer": {"const": "catalog"}, "order_id": {"type": "null"}, "payload": {"$ref": "change-lifecycle.v1.schema.json#/$defs/requested"}}}},
    {"if": {"properties": {"type": {"const": "ChangeCommittedV1"}}}, "then": {"properties": {"producer": {"const": "catalog"}, "order_id": {"type": "null"}, "payload": {"$ref": "change-lifecycle.v1.schema.json#/$defs/committed"}}}},
    {"if": {"properties": {"type": {"const": "EventCancelledV1"}}}, "then": {"properties": {"producer": {"const": "catalog"}, "order_id": {"type": "null"}, "payload": {"$ref": "change-lifecycle.v1.schema.json#/$defs/cancelled"}}}},
    {"if": {"properties": {"type": {"const": "ChangeAcknowledgedV1"}}}, "then": {"properties": {"producer": {"enum": ["purchases", "ticketing"]}, "order_id": {"type": "null"}, "payload": {"$ref": "change-lifecycle.v1.schema.json#/$defs/ack"}}, "allOf": [{"if": {"properties": {"producer": {"const": "purchases"}}}, "then": {"properties": {"payload": {"properties": {"owner": {"const": "purchases"}}}}}}, {"if": {"properties": {"producer": {"const": "ticketing"}}}, "then": {"properties": {"payload": {"properties": {"owner": {"const": "ticketing"}}}}}}]}},
    {"if": {"properties": {"type": {"const": "ChangeReopenRequestedV1"}}}, "then": {"properties": {"producer": {"const": "catalog"}, "order_id": {"type": "null"}, "payload": {"allOf": [{"$ref": "change-reopen.v1.schema.json"}, {"properties": {"phase": {"const": "REQUESTED"}}}]}}}},
    {"if": {"properties": {"type": {"const": "ChangeReopenPreparedV1"}}}, "then": {"properties": {"producer": {"const": "purchases"}, "order_id": {"type": "null"}, "payload": {"allOf": [{"$ref": "change-reopen.v1.schema.json"}, {"properties": {"phase": {"const": "PREPARED"}}}]}}}},
    {"if": {"properties": {"type": {"const": "ChangeReopenCommittedV1"}}}, "then": {"properties": {"producer": {"const": "catalog"}, "order_id": {"type": "null"}, "payload": {"allOf": [{"$ref": "change-reopen.v1.schema.json"}, {"properties": {"phase": {"const": "COMMIT"}}}]}}}},
    {"if": {"properties": {"type": {"const": "EventSaleGateOpenedV1"}}}, "then": {"properties": {"producer": {"const": "purchases"}, "order_id": {"type": "null"}, "payload": {"allOf": [{"$ref": "change-reopen.v1.schema.json"}, {"properties": {"phase": {"const": "OPENED"}}}]}}}},
    {"if": {"properties": {"type": {"enum": ["ExecuteRefundRequestedV1", "SetTicketsRefundedV1", "BlockTicketsForRefundV1"]}}}, "then": {"properties": {"payload": {"allOf": [{"if": {"properties": {"scope": {"const": "ADJUSTMENT"}}, "required": ["scope"]}, "then": {"properties": {"adjustment_id": {"type": "string", "format": "uuid"}, "adjustment_snapshot": {"$ref": "adjustment-snapshot.v1.schema.json"}}, "required": ["adjustment_snapshot"]}}, {"if": {"properties": {"scope": {"const": "ORDER"}}, "required": ["scope"]}, "then": {"properties": {"adjustment_id": {"type": "null"}, "adjustment_snapshot": {"type": "null"}}}}]}}}},
    {"if": {"properties": {"type": {"const": "OfferChangeRequestedV1"}}}, "then": {"properties": {"producer": {"const": "catalog"}, "order_id": {"type": "null"}, "payload": {"$ref": "#/$defs/offer"}}}},
    {"if": {"properties": {"type": {"enum": ["OfferAppliedV1", "OfferRejectedV1"]}}}, "then": {"properties": {"producer": {"const": "purchases"}, "order_id": {"type": "null"}, "payload": {"$ref": "#/$defs/offerResult"}}}},
    {"if": {"properties": {"type": {"const": "EventMilestoneRecordedV1"}}}, "then": {"properties": {"producer": {"const": "catalog"}, "order_id": {"type": "null"}, "payload": {"$ref": "#/$defs/milestone"}}}},
    {"if": {"properties": {"type": {"const": "CanonicalPaymentFactV1"}}}, "then": {"properties": {"producer": {"const": "payments"}, "order_id": {"$ref": "#/$defs/uuid"}, "payload": {"$ref": "#/$defs/paymentFact"}}}},
    {"if": {"properties": {"type": {"const": "ReconcilePaymentRequestedV1"}}}, "then": {"properties": {"producer": {"const": "purchases"}, "order_id": {"$ref": "#/$defs/uuid"}, "payload": {"$ref": "#/$defs/reconcile"}}}},
    {"if": {"properties": {"type": {"const": "IssueTicketsRequestedV1"}}}, "then": {"properties": {"producer": {"const": "purchases"}, "order_id": {"$ref": "#/$defs/uuid"}, "payload": {"$ref": "#/$defs/issue"}}}},
    {"if": {"properties": {"type": {"const": "CloseIssuanceRequestedV1"}}}, "then": {"properties": {"producer": {"const": "purchases"}, "order_id": {"$ref": "#/$defs/uuid"}, "payload": {"$ref": "#/$defs/closeIssue"}}}},
    {"if": {"properties": {"type": {"const": "BlockTicketsForRefundV1"}}}, "then": {"properties": {"producer": {"const": "purchases"}, "order_id": {"$ref": "#/$defs/uuid"}, "payload": {"$ref": "#/$defs/refundGuard"}}}},
    {"if": {"properties": {"type": {"enum": ["TicketsIssuedV1", "IssuanceClosedV1"]}}}, "then": {"properties": {"producer": {"const": "ticketing"}, "order_id": {"$ref": "#/$defs/uuid"}, "payload": {"$ref": "#/$defs/issueResult"}}}},
    {"if": {"properties": {"type": {"const": "RefundGuardAppliedV1"}}}, "then": {"properties": {"producer": {"const": "ticketing"}, "order_id": {"$ref": "#/$defs/uuid"}, "payload": {"$ref": "#/$defs/guardResult"}}}},
    {"if": {"properties": {"type": {"const": "ReleaseRefundGuardV1"}}}, "then": {"properties": {"producer": {"const": "purchases"}, "order_id": {"$ref": "#/$defs/uuid"}, "payload": {"$ref": "#/$defs/releaseGuard"}}}},
    {"if": {"properties": {"type": {"const": "RefundGuardReleasedV1"}}}, "then": {"properties": {"producer": {"const": "ticketing"}, "order_id": {"$ref": "#/$defs/uuid"}, "payload": {"$ref": "#/$defs/releasedGuard"}}}},
    {"if": {"properties": {"type": {"const": "ExecuteRefundRequestedV1"}}}, "then": {"properties": {"producer": {"const": "purchases"}, "order_id": {"$ref": "#/$defs/uuid"}, "payload": {"$ref": "#/$defs/refundCommand"}}}},
    {"if": {"properties": {"type": {"const": "RefundObservedV1"}}}, "then": {"properties": {"producer": {"const": "payments"}, "order_id": {"$ref": "#/$defs/uuid"}, "payload": {"$ref": "#/$defs/refundResult"}}}},
    {"if": {"properties": {"type": {"const": "SetTicketsRefundedV1"}}}, "then": {"properties": {"producer": {"const": "purchases"}, "order_id": {"$ref": "#/$defs/uuid"}, "payload": {"$ref": "#/$defs/setRefunded"}}}},
    {"if": {"properties": {"type": {"const": "EmissionCommittedV1"}}}, "then": {"properties": {"producer": {"const": "ticketing"}, "order_id": {"type": "null"}, "payload": {"$ref": "#/$defs/emission"}}}},
    {"if": {"properties": {"type": {"const": "ProofStatusObservedV1"}}}, "then": {"properties": {"producer": {"const": "blockchain"}, "order_id": {"type": "null"}, "payload": {"$ref": "#/$defs/proof"}}}},
    {"if": {"properties": {"type": {"const": "ContactReferenceChangedV1"}}}, "then": {"properties": {"producer": {"const": "identity"}, "order_id": {"type": "null"}, "payload": {"$ref": "#/$defs/contact"}}}},
    {"if": {"properties": {"type": {"const": "NotificationRequestedV1"}}}, "then": {"properties": {"producer": {"const": "purchases"}, "order_id": {"$ref": "#/$defs/uuid"}, "payload": {"$ref": "#/$defs/notification"}}}}
  ],
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"},
    "instant": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "version": {"type": "integer", "minimum": 1},
    "money": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"},
    "serviceRate": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$", "description": "Igual common.yaml ServiceRate: no negativo, hasta seis decimales; no nuevo máximo comercial."},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullableInstant": {"type": ["string", "null"], "format": "date-time"},
    "offer": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "offer_version", "order_limit", "account_event_limit", "hold_ttl_seconds", "grace_seconds", "service_rate", "localities", "fiscal"],
      "properties": {
        "event_id": {"$ref": "#/$defs/uuid"}, "offer_version": {"$ref": "#/$defs/version"},
        "order_limit": {"type": "integer", "minimum": 1}, "account_event_limit": {"type": "integer", "minimum": 1},
        "hold_ttl_seconds": {"type": "integer", "minimum": 1}, "grace_seconds": {"type": "integer", "minimum": 1},
        "service_rate": {"$ref": "#/$defs/serviceRate"},
